+/* ------------------ Stripe: canister -> product mapping ----------------- */
+// Products are mirrored into Stripe with metadata.canister_product_id set to
+// the canister's Product.id. Referencing them by id gives Checkout the catalog
+// image, name and description instead of a bare ad-hoc line item.
+//
+// The AMOUNT still comes from the canister on every call. We pass `product`
+// inside price_data rather than a stored `price` id, so the canister stays the
+// single source of truth for pricing and a price change needs no Stripe write.
+
+let productMap = new Map();
+let productMapLoadedAt = 0;
+const PRODUCT_MAP_TTL_MS = 10 * 60 * 1000;
+
+async function loadProductMap(force = false) {
+  if (!force && Date.now() - productMapLoadedAt < PRODUCT_MAP_TTL_MS) return productMap;
+  const next = new Map();
+  try {
+    for await (const product of stripe.products.list({ active: true, limit: 100 })) {
+      const id = product.metadata?.canister_product_id;
+      if (id) next.set(String(id), product.id);
+    }
+    productMap = next;
+    productMapLoadedAt = Date.now();
+  } catch (err) {
+    // Keep whatever we had. A stale map degrades to ad-hoc line items; it
+    // must never take the checkout down.
+    console.error('[product-map] refresh failed:', err.message);
+  }
+  return productMap;
+}
